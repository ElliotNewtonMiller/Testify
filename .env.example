# Copy to .env (which git ignores) and fill in. Used by docker-compose.yml.
# Generate each secret with: openssl rand -hex 32

# Password for the bundled PostgreSQL database.
POSTGRES_PASSWORD=

# Signs everyone's sign-ins. Required; at least 32 characters. Keep it stable: changing it signs everyone out.
JWT_SECRET=

# Encrypts the SMTP password saved in Admin Panel -> Email and webhooks' signing secrets. At least 32
# characters. Optional, but without it no mail password can be saved and no webhook created. Keep it
# stable: changing it means re-entering that password and rotating webhook secrets.
SECRETS_KEY=

# The first admin's password (username: admin), used only when the database has no users yet.
# Leave empty to have a random one printed once in the log (`docker compose logs testify`),
# which must then be changed at first sign-in.
ADMIN_PASSWORD=

# Set to true when Testify runs behind a reverse proxy (nginx, Caddy, Traefik, a load balancer).
TRUST_PROXY=false

# true lets webhooks reach localhost and link-local addresses (refused otherwise). Private-network
# addresses (10.x, 192.168.x, ...) work either way.
WEBHOOK_ALLOW_LOCAL=false

# Port on this machine.
TESTIFY_PORT=3001
